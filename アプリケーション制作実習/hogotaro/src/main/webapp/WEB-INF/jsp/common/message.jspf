<%--   <%@ include file="/WEB-INF/jsp/common/message.jspf" %>   でインクルード（<div class="container"> の先頭）--%>

<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%-- 登録・編集・削除できなかった時のメッセージ（フラッシュ。1回だけ表示される）
     Controller で redirectAttributes.addFlashAttribute("message", "…") と渡したものが入る --%>
<c:if test="${not empty message}">
  <div class="alert alert-warning"><c:out value="${message}"/></div>
</c:if>
