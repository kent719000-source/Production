<%--   各ページの <head> の中で  <%@ include file="/WEB-INF/jsp/common/head.jspf" %>  と書いて読み込む
       <title> だけは画面ごとに違うので、include の下に各ページで書く --%>

<%@ page pageEncoding="UTF-8" %>

<%-- taglibの宣言。ここで宣言しておけば、各ページで書かなくても c: fn: form: などが使える --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>

<%-- コンテキストパスを短い名前で使えるようにしておく（各ページでは ${ctx}/adopter のように書く） --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>

<meta charset="UTF-8">
<%-- スマホでも画面幅に合わせて表示する --%>
<meta name="viewport" content="width=device-width, initial-scale=1">

<%-- ファビコン（ブラウザのタブのアイコン） --%>
<link rel="icon" href="${ctx}/images/favicon.ico">
<link rel="apple-touch-icon" href="${ctx}/images/apple-touch-icon.png">

<%-- 1. Bootstrap --%>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

<%-- 2. 丸ゴシック体（Zen Maru Gothic）を Google Fonts から読み込む --%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet">

<%-- 3. ホゴタロウ共通スタイル（必ずBootstrapより後に読み込む） --%>
<link href="${ctx}/css/hogotarou.css" rel="stylesheet">
